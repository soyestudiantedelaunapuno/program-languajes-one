Algoritmo CalcularIGB
    // Definición de variables
    Definir IGB, Precio_producto, Precio_Final, Como Real
    
    Escribir "Ingrese el precio inicial del producto:"
    Leer Precio_inicial
    
    IGB <- (Precio_inicial * 0.18)
    Precio_Final <- Precio_Inicial + IGB

    
    // Salida de resultados
    Escribir "El monto del IGB es:" IGB
    Escribir " El Precio total es:" Precio_Final
FinAlgoritmo
